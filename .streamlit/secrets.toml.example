# Copiá este archivo a .streamlit/secrets.toml y completá tu API key.
# .streamlit/secrets.toml nunca se commitea (ver .gitignore).

# Obligatorio. Se genera en https://console.groq.com/keys
GROQ_API_KEY = "tu_api_key_de_groq"

# Opcional. Cambia el modelo sin tocar el código.
#
# Si no se define, la app usa openai/gpt-oss-120b. Groq da de baja modelos
# con fecha fija, así que cuando el actual deje de funcionar alcanza con
# mirar https://console.groq.com/docs/models, cargar acá uno vigente y
# reiniciar la app.
#
# GROQ_MODEL = "openai/gpt-oss-120b"
